{
  "name": "agent-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:hook": "esbuild server/gate/hook.ts --bundle --platform=node --format=esm --outfile=dist/hook.mjs --log-level=warning",
    "dev": "npm run build:hook && concurrently -k -n server,web \"AGENT_CHAT_DEV=1 tsx watch --clear-screen=false server/index.ts\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts && npm run build:hook && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs --log-level=warning",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:visual": "vite build --config web/vite.config.ts && playwright test",
    "gate:inventory": "tsx server/gate/inventory-cli.ts",
    "migrate:blocks": "tsx server/scripts/migrate-blocks.ts",
    "test:perf": "vite build --config web/vite.config.ts && VISUAL_BULK=200,500 playwright test perf"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "^13.0.3",
    "comark": "0.7.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.9",
    "picomatch": "^4.0.7",
    "shell-quote": "^1.10.0",
    "ulid": "^3.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@comark/react": "0.7.0",
    "@phosphor-icons/react": "2.1.10",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/shell-quote": "^1.7.5",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "2.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "hack-font": "3.3.0",
    "jsdom": "30.1.1",
    "mermaid": "12.0.0",
    "motion": "13.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup-plugin-visualizer": "7.1.1",
    "shiki": "4.4.3",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
